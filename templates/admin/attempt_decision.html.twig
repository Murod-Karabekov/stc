{% extends 'base.html.twig' %}

{% block title %}Nomzod qarori — {{ attempt.candidateCode }} — JDPU STC Admin{% endblock %}

{% block body %}
<div class="min-h-screen bg-zinc-950 text-zinc-100 font-mono px-6 py-10">
  <div class="max-w-md mx-auto">
    <div class="mb-6">
      <a href="/admin/exam-attempt" class="text-zinc-500 hover:text-zinc-200 text-xs tracking-widest uppercase">← Nomzodlar ro'yxati</a>
    </div>

    <h1 class="text-xl font-semibold mb-6">Nomzod qarori</h1>

    <div class="border border-zinc-800 rounded mb-6">
      <dl class="divide-y divide-zinc-800">
        <div class="flex px-4 py-3">
          <dt class="w-36 text-zinc-500 text-sm">Nomzod kodi:</dt>
          <dd class="text-zinc-200 text-sm"><code>{{ attempt.candidateCode }}</code></dd>
        </div>
        <div class="flex px-4 py-3">
          <dt class="w-36 text-zinc-500 text-sm">Imtihon:</dt>
          <dd class="text-zinc-200 text-sm">{{ attempt.exam }}</dd>
        </div>
        <div class="flex px-4 py-3">
          <dt class="w-36 text-zinc-500 text-sm">Holat:</dt>
          <dd class="text-zinc-200 text-sm">{{ attempt.status }}</dd>
        </div>
        <div class="flex px-4 py-3">
          <dt class="w-36 text-zinc-500 text-sm">Ball:</dt>
          <dd class="text-zinc-200 text-sm font-semibold">{{ attempt.totalScore }} / {{ attempt.maxScore }}</dd>
        </div>
        {% if attempt.decisionChangedBy %}
          <div class="flex px-4 py-3">
            <dt class="w-36 text-zinc-500 text-sm">Oxirgi qaror:</dt>
            <dd class="text-zinc-400 text-sm">{{ attempt.decisionChangedBy }}{% if attempt.decisionChangedAt %}, {{ attempt.decisionChangedAt|date('d.m.Y H:i') }}{% endif %}</dd>
          </div>
        {% endif %}
      </dl>
    </div>

    <form method="post">
      <input type="hidden" name="_token" value="{{ csrf_token('decision_' ~ attempt.id) }}">

      <p class="text-zinc-400 text-sm mb-3">Qarorni tanlang:</p>
      <div class="border border-zinc-800 rounded mb-6 divide-y divide-zinc-800">
        {% for value, label in decisions %}
          <label class="flex items-center gap-3 px-4 py-3 cursor-pointer hover:bg-zinc-900 transition-colors">
            <input type="radio" name="decision" value="{{ value }}"
                   {{ attempt.selectionDecision == value ? 'checked' : '' }}
                   class="accent-zinc-400">
            <span class="text-sm text-zinc-200">{{ label }}</span>
          </label>
        {% endfor %}
      </div>

      <div class="flex gap-3">
        <a href="/admin/exam-attempt"
           class="px-4 py-2 border border-zinc-700 text-zinc-300 text-sm rounded hover:border-zinc-500 transition-colors">
          Orqaga
        </a>
        <button type="submit"
                class="px-4 py-2 bg-zinc-100 text-zinc-900 text-sm rounded hover:bg-white transition-colors">
          Saqlash
        </button>
      </div>
    </form>
  </div>
</div>
{% endblock %}
