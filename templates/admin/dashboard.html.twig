{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Boshqaruv paneli{% endblock %}

{% block main %}
<div class="container-fluid py-4">
    <h1 class="h3 mb-4">Boshqaruv paneli</h1>

    {% if exam %}
        <div class="alert alert-{{ exam.isOpen ? 'success' : 'secondary' }} mb-4">
            <strong>Joriy tanlov:</strong> {{ exam.title }} ({{ exam.code }})
            &mdash;
            {% if exam.isOpen %}
                <span class="badge bg-success">Qabul ochiq</span>
            {% else %}
                <span class="badge bg-secondary">Qabul yopiq</span>
            {% endif %}
            {% if exam.isPublished %}
                <span class="badge bg-primary ms-1">Natijalar e'lon qilingan</span>
            {% endif %}
        </div>
    {% else %}
        <div class="alert alert-warning mb-4">Hozircha hech qanday tanlov yaratilmagan.</div>
    {% endif %}

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card text-center h-100">
                <div class="card-body">
                    <div class="display-5 fw-bold text-primary">{{ candidateCount }}</div>
                    <div class="text-muted mt-1">Ro'yxatdan o'tgan nomzodlar</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card text-center h-100">
                <div class="card-body">
                    <div class="display-5 fw-bold text-warning">{{ inProgress }}</div>
                    <div class="text-muted mt-1">Imtihon jarayonida</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card text-center h-100">
                <div class="card-body">
                    <div class="display-5 fw-bold text-success">{{ completed }}</div>
                    <div class="text-muted mt-1">Yakunlangan</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card text-center h-100">
                <div class="card-body">
                    <div class="display-5 fw-bold text-info">{{ inProgress + completed }}</div>
                    <div class="text-muted mt-1">Jami urinishlar</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header fw-semibold">Tez harakatlar</div>
                <div class="list-group list-group-flush">
                    <a href="{{ ea_url().setController('App\\Controller\\Admin\\ExamCrudController').setAction('index').generateUrl() }}" class="list-group-item list-group-item-action">
                        <i class="fa-solid fa-graduation-cap me-2"></i> Saralashni boshqarish
                    </a>
                    <a href="{{ ea_url().setController('App\\Controller\\Admin\\ExamAttemptCrudController').setAction('index').generateUrl() }}" class="list-group-item list-group-item-action">
                        <i class="fa-solid fa-users me-2"></i> Nomzodlar va natijalar
                    </a>
                    <a href="{{ ea_url().setController('App\\Controller\\Admin\\QuestionCrudController').setAction('index').generateUrl() }}" class="list-group-item list-group-item-action">
                        <i class="fa-solid fa-circle-question me-2"></i> Savollar banki
                    </a>
                    <a href="{{ path('admin_export_csv') }}" class="list-group-item list-group-item-action">
                        <i class="fa-solid fa-file-csv me-2"></i> CSV eksport
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header fw-semibold">Tanlov holati</div>
                <div class="card-body">
                    {% if exam %}
                        <dl class="row mb-0">
                            <dt class="col-sm-6">Nomi:</dt>
                            <dd class="col-sm-6">{{ exam.title }}</dd>
                            <dt class="col-sm-6">Kodi:</dt>
                            <dd class="col-sm-6"><code>{{ exam.code }}</code></dd>
                            <dt class="col-sm-6">Davomiyligi:</dt>
                            <dd class="col-sm-6">{{ exam.durationMinutes }} daqiqa</dd>
                            <dt class="col-sm-6">Qabul holati:</dt>
                            <dd class="col-sm-6">{{ exam.isOpen ? 'Ochiq' : 'Yopiq' }}</dd>
                            <dt class="col-sm-6">Natijalar:</dt>
                            <dd class="col-sm-6">
                                {% if exam.isPublished %}
                                    E'lon qilingan{% if exam.publishedAt %} ({{ exam.publishedAt|date('d.m.Y H:i') }}){% endif %}
                                {% else %}
                                    E'lon qilinmagan
                                {% endif %}
                            </dd>
                        </dl>
                    {% else %}
                        <p class="text-muted mb-0">Tanlov topilmadi.</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
