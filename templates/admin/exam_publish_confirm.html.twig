{% extends 'base.html.twig' %}

{% block title %}Natijalarni e'lon qilish — JDPU STC Admin{% endblock %}

{% block body %}
<div class="min-h-screen bg-zinc-950 text-zinc-100 font-mono px-6 py-10">
  <div class="max-w-lg mx-auto">
    <div class="mb-6">
      <a href="/admin/exam" class="text-zinc-500 hover:text-zinc-200 text-xs tracking-widest uppercase">← Saralash ro'yxati</a>
    </div>

    <h1 class="text-xl font-semibold mb-6">Natijalarni e'lon qilish — tasdiqlash</h1>

    <div class="border border-zinc-800 rounded mb-6">
      <dl class="divide-y divide-zinc-800">
        <div class="flex px-4 py-3">
          <dt class="w-48 text-zinc-500 text-sm">Tanlov:</dt>
          <dd class="text-zinc-200 text-sm">{{ exam.title }} (<code>{{ exam.code }}</code>)</dd>
        </div>
        <div class="flex px-4 py-3">
          <dt class="w-48 text-zinc-500 text-sm">Yakunlangan urinishlar:</dt>
          <dd class="text-zinc-200 text-sm font-bold">{{ finalizedCount }}</dd>
        </div>
        <div class="flex px-4 py-3">
          <dt class="w-48 text-zinc-500 text-sm">Qaror kutilayotganlar:</dt>
          <dd class="text-sm">
            {% if pendingDecisionCount > 0 %}
              <span class="px-2 py-0.5 rounded bg-amber-900 text-amber-300 text-xs">{{ pendingDecisionCount }}</span>
              <span class="text-zinc-500 text-xs ml-1">(e'lon qilgandan keyin ham o'zgartirish mumkin)</span>
            {% else %}
              <span class="px-2 py-0.5 rounded bg-green-900 text-green-300 text-xs">0</span>
            {% endif %}
          </dd>
        </div>
      </dl>
    </div>

    <div class="border border-amber-800 bg-amber-950/40 rounded px-4 py-3 mb-6 text-sm text-amber-200">
      E'lon qilgandan so'ng <strong>nomzodlar o'z natijalarini ko'ra oladi</strong>.
      Bu amalni <strong>bekor qilib bo'lmaydi</strong>.
    </div>

    <form method="post" action="{{ path('admin_exam_publish', {id: exam.id}) }}">
      <input type="hidden" name="_token" value="{{ csrf_token('publish_exam_' ~ exam.id) }}">
      <div class="flex gap-3">
        <a href="/admin/exam"
           class="px-4 py-2 border border-zinc-700 text-zinc-300 text-sm rounded hover:border-zinc-500 transition-colors">
          Bekor qilish
        </a>
        <button type="submit"
                class="px-4 py-2 bg-amber-600 text-white text-sm rounded hover:bg-amber-500 transition-colors">
          Ha, e'lon qilish
        </button>
      </div>
    </form>
  </div>
</div>
{% endblock %}
