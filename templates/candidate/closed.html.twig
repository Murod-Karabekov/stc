{% extends 'base.html.twig' %}
{% block title %}JDPU STC — Saralash yopiq{% endblock %}
{% block body %}
<div class="min-h-screen bg-[#08080a] text-zinc-100 flex flex-col justify-center items-center px-4 py-16 relative overflow-hidden">
  <div class="absolute inset-0 z-0 pointer-events-none scanlines opacity-25"></div>
  <div class="relative z-10 w-full max-w-md border border-zinc-800 bg-zinc-950/90 p-8 rounded-sm shadow-2xl backdrop-blur-md text-center">
    <div class="mb-6">
      <div class="inline-flex items-center space-x-2 mb-4">
        <span class="w-2 h-2 rounded-full bg-zinc-600"></span>
        <span class="font-mono text-xs tracking-[0.2em] text-zinc-400 uppercase">JDPU STC // SARALASH</span>
      </div>
    </div>
    <div class="mb-6">
      <div class="w-12 h-12 mx-auto mb-4 border border-zinc-700 rounded-full flex items-center justify-center">
        <svg class="w-6 h-6 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m0 0v2m0-2h2m-2 0H10M6 18H4a2 2 0 01-2-2V8a2 2 0 012-2h4V4a2 2 0 012-2h4a2 2 0 012 2v2h4a2 2 0 012 2v8a2 2 0 01-2 2h-2"/>
        </svg>
      </div>
      <h1 class="font-mono text-sm text-zinc-200 tracking-wider uppercase mb-3">Saralash yopiq</h1>
      <p class="font-mono text-xs text-zinc-400 leading-relaxed">{{ message|default('Hozirda volontyorlik saralash jarayoni yopiq. Yangi ma\'lumotlar uchun kuzatib boring.') }}</p>
    </div>
    <a href="{{ path('app_home') }}" class="inline-flex items-center gap-2 font-mono text-xs text-zinc-500 hover:text-zinc-300 transition-colors">
      ← Bosh sahifaga qaytish
    </a>
  </div>
</div>
{% endblock %}
