{% extends 'base.html.twig' %}

{% block title %}JDPU STC — Nomzodlarni ro'yxatga olish{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#08080a] text-zinc-100 flex flex-col justify-center items-center px-4 py-12 relative overflow-hidden">
  
  <div class="absolute inset-0 z-0 pointer-events-none scanlines opacity-25"></div>

  <div class="relative z-10 w-full max-w-md border border-zinc-800 bg-zinc-950/90 p-8 rounded-sm shadow-2xl backdrop-blur-md">
    
    <!-- Top badge -->
    <div class="mb-6 border-b border-zinc-800/80 pb-4">
      <div class="flex items-center space-x-2 mb-1.5">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <h1 class="font-mono text-xs tracking-[0.2em] text-zinc-300 uppercase">JDPU STC // SARALASH 2026</h1>
      </div>
      <p class="font-mono text-xs text-zinc-400 font-medium">Volontyorlikka kirish uchun ro'yxatdan o'tish</p>
    </div>

    <!-- Error flashes -->
    {% for label, messages in app.flashes %}
      {% for message in messages %}
        <div class="mb-5 p-3.5 bg-red-950/40 border border-red-900/60 rounded text-red-300 font-mono text-xs leading-relaxed">
          {{ message }}
        </div>
      {% endfor %}
    {% endfor %}

    {{ form_start(form, {'attr': {'class': 'space-y-5', 'novalidate': 'novalidate'}}) }}
      
      <!-- Field 1: Full name -->
      <div>
        <label for="{{ form.fullName.vars.id }}" class="block font-mono text-xs text-zinc-300 uppercase tracking-wider mb-2">
          To'liq ism va familiyangiz <span class="text-red-400">*</span>
        </label>
        {{ form_widget(form.fullName) }}
        {% if form_errors(form.fullName) %}
          <div class="mt-1.5 text-red-400 font-mono text-xs">
            {{ form_errors(form.fullName) }}
          </div>
        {% endif %}
      </div>

      <!-- Field 2: Phone number -->
      <div>
        <label for="{{ form.phone.vars.id }}" class="block font-mono text-xs text-zinc-300 uppercase tracking-wider mb-2">
          Telefon raqamingiz (+998) <span class="text-red-400">*</span>
        </label>
        {{ form_widget(form.phone) }}
        <p class="mt-1 text-[11px] font-mono text-zinc-500">
          Format: +998 90 123 45 67 (SMS yuborilmaydi, faqat identifikator sifatida olinadi)
        </p>
        {% if form_errors(form.phone) %}
          <div class="mt-1.5 text-red-400 font-mono text-xs">
            {{ form_errors(form.phone) }}
          </div>
        {% endif %}
      </div>

      <!-- Short Privacy Notice & Consent Checkbox -->
      <div class="pt-3 border-t border-zinc-800/80">
        <div class="flex items-start space-x-3">
          {{ form_widget(form.consent) }}
          <label for="{{ form.consent.vars.id }}" class="font-sans text-xs text-zinc-400 leading-snug cursor-pointer select-none">
            {{ form.consent.vars.label }}
          </label>
        </div>
        {% if form_errors(form.consent) %}
          <div class="mt-1 text-red-400 font-mono text-xs">
            {{ form_errors(form.consent) }}
          </div>
        {% endif %}

        <div class="mt-3 p-2.5 bg-zinc-900/60 border border-zinc-800/60 rounded text-[11px] font-mono text-zinc-500 leading-relaxed">
          Maxfiylik eslatmasi: Ko'rsatilgan ism va telefon raqami faqat ushbu saralash imtihoni natijalarini hisobga olish va aloqa o'rnatish uchun saqlanadi. Uchinchi shaxslarga berilmaydi.
        </div>
      </div>

      <!-- Submit button -->
      <button type="submit" 
              class="w-full py-3 px-4 bg-zinc-100 hover:bg-white text-zinc-950 font-mono text-xs font-semibold tracking-wider uppercase rounded-sm transition-all shadow-md cursor-pointer mt-4">
        Keyingi bosqich: Yo'riqnoma ↵
      </button>

      <div class="text-center pt-2">
        <a href="{{ path('app_home') }}" class="font-mono text-xs text-zinc-500 hover:text-zinc-300 transition-colors">
          ← Bosh sahifaga qaytish
        </a>
      </div>

    {{ form_end(form) }}

  </div>
</div>
{% endblock %}
