{% extends 'base.html.twig' %}
{% block title %}JDPU STC — Yo'riqnoma{% endblock %}
{% block body %}
<div class="min-h-screen bg-[#08080a] text-zinc-100 flex flex-col justify-center items-center px-4 py-10 relative overflow-hidden">
  <div class="absolute inset-0 z-0 pointer-events-none scanlines opacity-20"></div>

  <div class="relative z-10 w-full max-w-xl border border-zinc-800 bg-zinc-950/90 rounded-sm shadow-2xl backdrop-blur-md overflow-hidden">

    <!-- Header -->
    <div class="border-b border-zinc-800 px-7 py-5">
      <div class="flex items-center space-x-2 mb-1">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="font-mono text-[11px] tracking-[0.2em] text-zinc-300 uppercase">JDPU STC // SARALASH 2026</span>
      </div>
      <h1 class="font-mono text-sm text-zinc-100 tracking-wider uppercase mt-1">Testni boshlashdan oldin o'qing</h1>
    </div>

    <!-- Instructions body -->
    <div class="px-7 py-6 space-y-5 font-mono text-xs text-zinc-300 leading-relaxed">

      <div class="p-3.5 border border-zinc-800/70 bg-zinc-900/50 rounded-sm">
        <p class="text-zinc-200 font-semibold mb-2 uppercase tracking-wider text-[11px]">Imtihon haqida</p>
        <ul class="space-y-1.5 text-zinc-400">
          <li>→ Savollar soni: <span class="text-zinc-200">25 ta</span> (5 bo'lim × 5 savol)</li>
          <li>→ Vaqt: <span class="text-zinc-200">{{ exam.durationMinutes }} daqiqa</span></li>
          <li>→ Har bir to'g'ri javob: <span class="text-zinc-200">1 ball</span></li>
          <li>→ Maksimal ball: <span class="text-zinc-200">25</span></li>
          <li>→ Har bir savolda 4 ta javob varianti bor, faqat bittasi to'g'ri</li>
        </ul>
      </div>

      <div class="p-3.5 border border-zinc-800/70 bg-zinc-900/50 rounded-sm">
        <p class="text-zinc-200 font-semibold mb-2 uppercase tracking-wider text-[11px]">Bo'limlar</p>
        <ul class="space-y-1 text-zinc-400">
          <li>1. Mantiqiy va algoritmik fikrlash</li>
          <li>2. Muammoni tahlil qilish va xato sababini aniqlash</li>
          <li>3. Tizimli fikrlash va samarali yechim qurish</li>
          <li>4. Tanqidiy fikrlash va dalil asosida qaror qabul qilish</li>
          <li>5. Diskret matematika</li>
        </ul>
      </div>

      <div class="p-3.5 border border-amber-900/40 bg-amber-950/20 rounded-sm">
        <p class="text-amber-300 font-semibold mb-2 uppercase tracking-wider text-[11px]">Muhim eslatmalar</p>
        <ul class="space-y-1.5 text-zinc-400">
          <li>⟶ Vaqt server tomonida hisoblanadi — sahifani yangilash vaqtni to'xtatmaydi</li>
          <li>⟶ Javoblar avtomatik saqlanadi, ammo internet uzilishida sahifadan chiqmang</li>
          <li>⟶ Vaqt tugaganda test avtomatik topshiriladi</li>
          <li>⟶ Bir testga faqat bitta urinish huquqi berilgan</li>
          <li>⟶ Sahifa yoki oyna almashtirish qayd etiladi</li>
        </ul>
      </div>

      <div class="p-3.5 border border-zinc-800/70 bg-zinc-900/30 rounded-sm text-zinc-500 text-[11px] leading-relaxed">
        Testni boshlash tugmasi bosilgandan so'ng vaqt boshlanadi. Hamma savollarga javob berish shart emas — javob bermagan savollar noto'g'ri hisoblanmaydi.
      </div>
    </div>

    <!-- Footer CTA -->
    <div class="border-t border-zinc-800 px-7 py-5 flex flex-col sm:flex-row items-center justify-between gap-4">
      <a href="{{ path('app_home') }}" class="font-mono text-xs text-zinc-500 hover:text-zinc-300 transition-colors">
        ← Bosh sahifaga
      </a>
      <form method="GET" action="{{ path('app_candidate_exam') }}">
        <button type="submit"
                class="px-7 py-3 bg-zinc-100 hover:bg-white text-zinc-950 font-mono text-xs font-bold tracking-widest uppercase rounded-sm transition-all shadow-md cursor-pointer">
          Testni boshlash ↵
        </button>
      </form>
    </div>

  </div>
</div>
{% endblock %}
