# JDPU STC Platform Environment Configuration
APP_ENV=prod
APP_SECRET=change_this_to_a_secure_random_hex_secret_in_production
DATABASE_URL="postgresql://stc_user:stc_password@127.0.0.1:5432/jdpu_stc?serverVersion=16&charset=utf8"
